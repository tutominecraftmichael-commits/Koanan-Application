# Configuration Firebase Authentication pour KONAN AI
# Remplacez les valeurs ci-dessous par celles de votre projet Firebase Console
# (Console Firebase > Paramètres du projet > Vos applications > Web SDK)

VITE_FIREBASE_API_KEY=AIzaSyDummyKeyReplaceWithYourRealOne
VITE_FIREBASE_AUTH_DOMAIN=konan-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=konan-ai
VITE_FIREBASE_STORAGE_BUCKET=konan-ai.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Configuration Google Gemini Multimodal Vision (Numérisation intelligente d'emplois du temps)
GEMINI_API_KEY=votre_cle_gemini_api_ici
VITE_GEMINI_API_KEY=votre_cle_gemini_api_ici

# Configuration Web Push VAPID (Notifications en arrière-plan PWA)
VITE_VAPID_PUBLIC_KEY=votre_cle_publique_vapid
VAPID_PUBLIC_KEY=votre_cle_publique_vapid
VAPID_PRIVATE_KEY=votre_cle_privee_vapid
VAPID_SUBJECT=mailto:contact@konan-ai.com

