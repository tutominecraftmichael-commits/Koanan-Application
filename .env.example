# Configuration Firebase Authentication pour KONAN AI
# Remplacez les valeurs ci-dessous par celles de votre projet Firebase Console
# (Console Firebase > Paramètres du projet > Vos applications > Web SDK)

VITE_FIREBASE_API_KEY=AIzaSyDummyKeyReplaceWithYourRealOne
VITE_FIREBASE_AUTH_DOMAIN=konan-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=konan-ai
VITE_FIREBASE_STORAGE_BUCKET=konan-ai.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Google Gemini (lecture des emplois du temps) : clé SECRÈTE, utilisée uniquement par le serveur (api/extract-timetable.js).
# Ne jamais la nommer VITE_GEMINI_API_KEY : les variables VITE_ sont copiées dans le code public.
GEMINI_API_KEY=votre_cle_gemini_api_ici

# Web Push VAPID (notifications). La clé PRIVÉE est un secret serveur : jamais dans le code ni dans une variable VITE_.
# Générer une paire : npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=votre_cle_publique_vapid
VAPID_PUBLIC_KEY=votre_cle_publique_vapid
VAPID_PRIVATE_KEY=votre_cle_privee_vapid
VAPID_SUBJECT=mailto:contact@konan-ai.com

# Secret partagé exigé par /api/cron-notifications (en-tête X-Cron-Secret envoyé par cron-job.org)
CRON_SECRET=une_longue_chaine_aleatoire

# Console administrateur : mot de passe vérifié UNIQUEMENT par le serveur (/api/admin-data).
# Ne jamais utiliser VITE_ADMIN_PASSWORD ni NEXT_PUBLIC_ADMIN_PASSWORD : ces variables sont copiées dans le code public.
ADMIN_PASSWORD=choisissez_un_mot_de_passe_long_et_unique

# Paiement de KONAN Pro par SasPay (serveur uniquement, jamais de variable VITE_).
# KONAN_PAYMENTS=on allume le paiement. Clé sk_test_... = bac à sable (aucun argent réel), sk_live_... = paiements réels
# (refusée sur l'ordinateur). APP_URL = adresse publique de l'application, sans / final (retour après paiement).
KONAN_PAYMENTS=
SASPAY_API_KEY=
APP_URL=

# Mode « Je ne comprends pas » (professeur particulier, abonnés Pro payants, 30 messages par jour et par élève).
# KONAN_TUTOR=on l'allume EN LIGNE : à mettre seulement quand la facturation Gemini est activée.
# KONAN_TUTOR_DAILY_BUDGET = messages par jour pour toute l'appli (500 par défaut), pour limiter la facture.
KONAN_TUTOR=
KONAN_TUTOR_DAILY_BUDGET=
# Voix de KONAN (lecture des réponses à voix haute) : lectures par jour pour toute l'appli (150 par défaut)
# et nom de la voix Gemini (Puck par défaut : petit garçon joyeux).
KONAN_TUTOR_VOICE_BUDGET=
KONAN_VOICE_NAME=
