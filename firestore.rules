rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque étudiant a un accès privé et exclusif à ses propres données (emploi du temps, matières, sessions)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Invitations KONAN PLUS partagées en temps réel entre étudiants (PC, mobile, tablettes)
    match /plus_invitations/{invitationId} {
      allow read, write: if true;
    }
  }
}
