rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque étudiant a un accès privé et exclusif à ses propres données (emploi du temps, matières, sessions)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && (!('planTier' in request.resource.data) || request.resource.data.planTier in ['free', 'pro', 'plus']);
    }

    // Invitations KONAN PLUS : synchronisation temps réel fluide et instantanée entre appareils
    match /plus_invitations/{invitationId} {
      allow read, write: if true;
    }
  }
}
