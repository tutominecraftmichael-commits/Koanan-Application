rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque étudiant a un accès privé et exclusif à ses propres données (emploi du temps, matières, sessions)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && (!('planTier' in request.resource.data) || request.resource.data.planTier in ['free', 'pro', 'plus']);
    }

    // Invitations KONAN PLUS : synchronisation temps réel avec validation stricte de schéma et d'immutabilité
    match /plus_invitations/{invitationId} {
      // Lecture autorisée pour la détection en temps réel sur les appareils cibles
      allow read: if true;

      // Création : strictement encadrée avec validation du schéma d'invitation initial
      allow create: if request.resource.data.id == invitationId
        && request.resource.data.status == 'pending'
        && request.resource.data.senderKonanId is string
        && request.resource.data.senderKonanId.size() >= 5
        && request.resource.data.senderKonanId.size() <= 20
        && request.resource.data.targetKonanIdOrEmail is string
        && request.resource.data.targetKonanIdOrEmail.size() >= 3
        && request.resource.data.targetKonanIdOrEmail.size() <= 100
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() >= 1
        && request.resource.data.senderName.size() <= 100
        && request.resource.data.createdAt is string;

      // Modification : autorisée uniquement pour la réponse ('accepted' ou 'declined')
      // Empêche formellement de modifier l'émetteur, le destinataire, ou de falsifier d'autres champs
      allow update: if resource.data.status == 'pending'
        && request.resource.data.id == resource.data.id
        && request.resource.data.senderKonanId == resource.data.senderKonanId
        && request.resource.data.targetKonanIdOrEmail == resource.data.targetKonanIdOrEmail
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'acceptedByName', 'acceptedByKonanId']);

      // Suppression directe non autorisée aux attaquants anonymes
      allow delete: if request.auth != null;
    }
  }
}
